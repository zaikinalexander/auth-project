[Unit]
Description=Auth Backend (Spring Boot)
After=network.target postgresql.service redis-server.service
Wants=postgresql.service redis-server.service

[Service]
User=authapp
Group=authapp
WorkingDirectory=/opt/auth-backend
EnvironmentFile=/etc/auth-backend/env
Environment=SERVER_ADDRESS=127.0.0.1
ExecStart=/usr/bin/java -Xms256m -Xmx512m -jar /opt/auth-backend/app.jar
SuccessExitStatus=143
Restart=on-failure
RestartSec=5

# Харденинг сервиса
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/auth-backend
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target